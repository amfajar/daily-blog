---
import { footerConfig, profileConfig } from "@/config";
import { url } from "@/utils/url-utils";

// Import custom footer HTML using Vite's ?raw import
// This works at build time and is compatible with all environments (Node.js, Cloudflare, etc.)
const footerFiles = import.meta.glob("../../config/FooterConfig.html", {
	query: "?raw",
	import: "default",
	eager: true,
});
const rawHtml = footerFiles["../../config/FooterConfig.html"] as string | undefined;
let customFooterHtml = "";
if (footerConfig.enable && rawHtml) {
	customFooterHtml = rawHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
}

const currentYear = new Date().getFullYear();
---


<div
  class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"
>
</div>

<div
  class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6"
>
  <div class="transition text-50 text-sm text-center">
    <div class="mb-2">
      {customFooterHtml && <div set:html={customFooterHtml} />}
    </div>
    <div class="m-0.5">
      &copy; <span id="copyright-year">{currentYear}</span>
      {profileConfig.name}. All Rights Reserved. /
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        href={url("rss.xml")}>RSS</a
      > /
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        href={url("sitemap-index.xml")}>Sitemap</a
      >
    </div>
    <div class="m-0.5">
      Powered by
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        href="https://astro.build">Astro</a
      > &
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        href="https://github.com/CuteLeaf/Firefly">Firefly</a
      >
    </div>
    <!-- 
      Note: Please do not modify or delete the "Powered by Astro & Firefly" part; this is a sign of respect and support for open source projects.
      If you need to add content to the footer, please set the 'enable' property to true in src/config/footerConfig.ts, then edit src/config/FooterConfig.html.
      You can add any custom content to src/config/FooterConfig.html as you like; there's no need to modify Footer.astro.
    -->
  </div>
</div>
